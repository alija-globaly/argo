{{- if .Values.pv.enabled }}
# 1. The StorageClass (The "Logic" for manual binding)
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: {{ .Values.storageClass | quote }}
provisioner: kubernetes.io/no-provisioner
volumeBindingMode: WaitForFirstConsumer
reclaimPolicy: Retain

---
# 2. PV for Replica 0
apiVersion: v1
kind: PersistentVolume
metadata:
  name: {{ .Values.pv.nameOne | quote }}
spec:
  capacity:
    storage: {{ .Values.pv.size | quote }}
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ .Values.storageClass | quote }}
  nfs:
    server: {{ .Values.pv.nfsServer }}
    path: {{ .Values.pv.nfsPathOne }} 
  claimRef:
    namespace: default
    name: data-my-first-lavinmq-0 # Matches the name the Operator generates

---
# 3. PV for Replica 1
apiVersion: v1
kind: PersistentVolume
metadata:
  name: {{ .Values.pv.nameTwo | quote }}
spec:
  capacity:
    storage: 5Gi
  accessModes:
    - ReadWriteOnce
  storageClassName: manual-storage
  nfs:
    server: nfs.agentcisinteral.com
    path: /agentcis-pvc/helm-test/lavinmq-data-1
  claimRef:
    namespace: default
    name: data-my-first-lavinmq-1

{{- end }}