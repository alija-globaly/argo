backend:
  name: agentcis-backend
  replicaCount: 1

  image:
    repository: 834033184010.dkr.ecr.ap-southeast-2.amazonaws.com/import-frontend
    tag: "import-frontend-01-19-596de9b"
    pullPolicy: IfNotPresent

  imagePullSecrets:
    enabled: true
    name: ecr-registry-secret

  startupCommand:
    enabled: true
    shell: /bin/sh
    command: |
      echo "-------------------------------"
      echo "k8s => restarting nginx"
      service nginx restart 
      echo "-------------------------------"
      echo "k8s => starting NODE backend"
      echo "-------------------------------"
      pnpm dev | tee -a /prod/packages/import-backend/logs/data-import-backend.log
  

  resources:
    requests:
      memory: "200Mi"
    limits:
      memory: "300Mi"

  pv:
    config:
      name: nfs-pv-data-import-config
      capacity: 5Gi
      nfsPath: /agentcis-manifest/data-import/config
      nfsServer: nfs.agentcisinteral.com
      reclaimPolicy: Retain
    log:
      name: nfs-pv-data-import-log
      capacity: 5Gi
      nfsPath: /agentcis-pvc/helm-test
      nfsServer: nfs.agentcisinteral.com
      reclaimPolicy: Retain

  pvc:
    config:
      name: nfs-config-pvc
    log:
      name: nfs-data-import-pvc
  

  volumes:
    enabled: true
    env:
      enabled: true
      pvcName: nfs-config-pvc
      mountPath: /prod/packages/import-backend/.env
      subPath: backend.env
    logs:
      enabled: true
      pvcName: nfs-data-import-pvc
      mountPath: /prod/packages/import-backend/logs
      subPath: import-backend-log

  affinity:
    enabled: false
    preferredNodes:
      - hostname: agentcis-staging-k8s-master-172-34-28-189
        weight: 100
      - hostname: other-server
        weight: 50

  # probe configurations
  livenessProbe:
    httpGet:
      path: /health-check
      port: 3002
    initialDelaySeconds: 30
    periodSeconds: 30
    failureThreshold: 3
  
  readinessProbe:
    httpGet:
      path: /health-check
      port: 3002
    initialDelaySeconds: 30
    periodSeconds: 30
  
  startupProbe:
    httpGet:
      path: /health-check
      port: 3002
    initialDelaySeconds: 30
    periodSeconds: 30
    failureThreshold: 3


  service:
    enabled: true
    type: NodePort
    containerport: 80
    svcport: 29000
    port: 3002
    portName: backend-node-port
    targetPort: 3002

  hpa:
    enabled: true
    minReplicas: 1
    maxReplicas: 3
    cpuUtilization: 50
    scaleUp:
      podsValue: 2
    scaleDown:
      podsValue: 1

  ingress:
    enabled: false
    clusterIssuer: lets-encrypt
    className: nginx
    host: subash.globalyhub.com
    className: nginx
    path: /
  httproute:
    enabled: true
    path: "/api/v1/agent-portal"
    gateway:
      name: "agentcisapp-stage-alb-gateway"
      namespace: "agentcisapp-gateway"
      sectionName: "https"
  targetGroupConfiguration:
    enabled: true
    targetType: "instance"
    healthCheckPath: "/"
    healthCheckProtocol: "HTTP"
    healthCheckInterval: 5
    healthCheckTimeout: 4      # ← ADD THIS LINE
    healthyThresholdCount: 2
    unhealthyThresholdCount: 2
    matcher:
      httpCode: "200-399,401-404"