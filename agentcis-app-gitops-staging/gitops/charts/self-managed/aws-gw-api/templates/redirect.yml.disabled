{{- if .Values.gateway.https_mode.enabled }}
---
apiVersion: gateway.networking.k8s.io/v1beta1
kind: HTTPRoute
metadata:
  name: {{ include "aws-gateway.httpRedirectName" . }}
  namespace: {{ .Release.Namespace }}
spec:
  parentRefs:
    - name: {{ include "aws-gateway.gatewayName" . }}
      kind: Gateway
      namespace: {{ .Release.Namespace }}
      sectionName: http
  rules:
    - filters:
        - type: RequestRedirect
          requestRedirect:
            scheme: https
            statusCode: 301
      backendRefs: []  # Redirects ALL HTTP → HTTPS
{{- end }}
