apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: agentcisapp-
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io/background   
spec:
  project: microservice
  source:
    repoURL: "https://github.com/alija-globaly/argo.git"
    targetRevision: "main"          # branch to deploy
    path: "agentcis-app-gitops-staging/gitops/charts/self-managed/frontend" # path to the Helm chart
    helm:
      valueFiles:
        - $values/gitops/values/staging/root-app-values/data-import-frontend-values.yml   # your frontend values file
  destination:
    server: https://kubernetes.default.svc
    namespace: agentcisapp-frontend
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - ApplyOutOfSyncOnly=true
      - PruneLast=true       
      - ServerSideApply=true
      - PrunePropagationPolicy=foreground      
      -